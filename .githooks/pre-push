#!/bin/sh

echo "Running admin_pwa build before push..."

if ! command -v pnpm >/dev/null 2>&1; then
  echo "Push blocked: pnpm is not installed or not available in PATH."
  exit 1
fi

pnpm --filter admin_pwa build
status=$?

if [ "$status" -ne 0 ]; then
  echo ""
  echo "Push blocked: admin_pwa build failed."
  echo "Fix the build errors and run git push again."
  exit "$status"
fi

echo "Build passed. Continuing push."
